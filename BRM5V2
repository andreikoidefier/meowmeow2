            reaction:Set(0); interval:Set(50); triggerRange:Set(6000); triggerPart:Set("Both")
        end})
    triggerTab:CreateText({name = "How it works", text = "Fires when the center crosshair crosses a visible eligible player's head or chest. Uses the player filters in ESP. Requires executor mouse1click support; Android support is unverified."})
    local visuals = window:CreateTab({name = "Visuals"})
    visuals:CreateToggle({name = "Custom camera FOV", flag = "CustomCameraFOV", value = config.CustomFOV,
