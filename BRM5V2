    farm:CreateButton({name = "Rise into air", callback = function()
        local actor = replicator.LocalActor
        if actor and actor.Alive and typeof(actor.Position) == "Vector3" then
            flyToggle:Set(true)
            flightGoalY = actor.Position.Y + config.FarmHeight
        end
    end})
    farm:CreateText({name = "Flight controls", text = "WASD: move. Space / E: up. Ctrl / Q: down. Release keys to hover. Disable flight to land."})
    farm:CreateText({name = "NPC display", text = "Optional ESP overlays for NPCs. This setting can also show friendlies."})
    farm:CreateToggle({name = "Show NPC ESP (includes friendlies)", value = config.NPCs, flag = "NPCsincludesfriendlies", forgetState = false,
        description = "Display only: shows living NPCs, including friendlies. This does not enable firing. Off by default.",
        callback = function(v) config.NPCs = v end})

    local triggerTab = window:CreateTab({name = "Triggerbot"})
    triggerTab:CreateToggle({name = "Enable triggerbot", flag = "TriggerEnabled", value = config.Trigger,
        callback = function(v) config.Trigger = v; triggerActor = nil end})
    local reaction = triggerTab:CreateSlider({name = "Reaction delay", flag = "TriggerDelay",
        range = {0, 300}, increment = 5, value = config.TriggerDelay, suffix = " ms",
