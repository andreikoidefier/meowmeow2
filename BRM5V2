if not loaded then stop(); error("BRM5 ESP GUI: " .. tostring(result)) end

table.insert(connections, Input.InputBegan:Connect(function(input, processed)
    if processed or Input:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.End then stop()
    elseif input.KeyCode == Enum.KeyCode.F7 then aimToggle:Set(not config.Aim)
    elseif input.KeyCode == Enum.KeyCode.RightShift and window and not window.unloaded then
        aimHeld = false; lockedActor = nil
        window:ToggleHide()
    end
end))

table.insert(connections, Input.WindowFocusReleased:Connect(function()
    aimHeld = false; lockedActor = nil
end))

local statusElapsed = 0
table.insert(connections, RunService.RenderStepped:Connect(function(dt)
    if stopped then return end
    if window.unloaded then stop(); return end
    applyFullbright()
    frames += 1
    applyNoFog()
    drawn, eligible = 0, 0
    for _, entry in pairs(entries) do hide(entry) end
    local camera = workspace.CurrentCamera
    local current = {}
    for _, actor in pairs(replicator.Actors) do
        current[actor] = true
        if config.Enabled and camera and targetAllowed(actor) then
            eligible += 1
            local entry = entries[actor]
            if not entry then entry = newEntry(); entries[actor] = entry end
            local ok, visible = pcall(updateActor, actor, entry, camera)
            if not ok then
                hide(entry)
                errors += 1
                if errors <= 3 then warn("BRM5 ESP draw: " .. tostring(visible)) end
            elseif visible then drawn += 1 end
        end
    end
    local triggerOK, triggerError = pcall(updateTrigger, camera, current)
    if not triggerOK then
        config.Trigger = false
        warn("BRM5 triggerbot disabled: " .. tostring(triggerError))
        marker:SetAttribute("TriggerStatus", tostring(triggerError))
    end
    local aimOK, aimError = pcall(updateAim, camera, dt, current)
    if not aimOK then
        aimHeld = false; lockedActor = nil; aimCircle.Visible = false
        aimErrors += 1
        aimState = "Aim error; see console"
        if aimErrors <= 3 then warn("BRM5 aim: " .. tostring(aimError)) end
    end
    local retired = {}
    for actor in pairs(entries) do if not current[actor] then table.insert(retired, actor) end end
    for _, actor in ipairs(retired) do erase(entries[actor]); entries[actor] = nil end
    statusElapsed += dt
    if statusElapsed >= 0.5 then
        statusElapsed = 0
        local mode = isPVP() and "PvP: opposing Red/Blue team" or "Open world: player overlay"
        liveStatus.Text = string.format("%s\n%d eligible / %d on screen\nFrames: %d | errors: %d", mode, eligible, drawn, frames, errors)
        marker:SetAttribute("Frames", frames)
        marker:SetAttribute("Eligible", eligible)
        marker:SetAttribute("Drawn", drawn)
        marker:SetAttribute("Errors", errors)
        marker:SetAttribute("Enabled", config.Enabled)
        marker:SetAttribute("Mode", mode)
        marker:SetAttribute("SettingsPath", select(2, window:GetPath()))
        marker:SetAttribute("AimEnabled", config.Aim)
        marker:SetAttribute("AimState", aimState)
        marker:SetAttribute("AimErrors", aimErrors)
        marker:SetAttribute("NoRecoil", config.NoRecoil)
        marker:SetAttribute("RecoilResets", recoilResets)
    end
end))
print("BRM5 ESP + Aim ready | press J: toggle aim | RightShift: menu | F6: ESP | F7: aim | End: unload")
return stop, window
