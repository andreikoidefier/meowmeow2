    settings:CreateKeybind({name = "Toggle ESP", value = Enum.KeyCode.F6, flag = "ToggleESP", forgetState = false,
        callback = function() masterToggle:Set(not config.Enabled) end})
    settings:CreateButton({name = "Unload ESP and aim", callback = stop})
    -- Restore only after every flag and callback exists; retain the library's typed
    -- colour, dropdown and keybind decoding rather than reinterpreting saved data.
    if settingsSnapshot then
        writefile(settingsPath, settingsSnapshot)
        assert(window:Load(), "Could not restore saved user settings")
    end
