local suppliedScope = ...
local runtimeScope: any = suppliedScope
local runtimeJournal = {}
local ownsRuntime = type(runtimeScope) ~= "table" or type(runtimeScope.override) ~= "function"
if ownsRuntime then
    runtimeScope = {}
    runtimeScope.override = function(object, key, value)
        table.insert(runtimeJournal, {object = object, key = key, value = rawget(object, key)})
        rawset(object, key, value)
    end
end
local function runtimeRestore()
    if not ownsRuntime then return end
    for i = #runtimeJournal, 1, -1 do
        local entry = runtimeJournal[i]
        rawset(entry.object, entry.key, entry.value)
    end
    table.clear(runtimeJournal)
end
