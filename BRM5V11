        aimErrors += 1
        aimState = "Aim error: " .. tostring(aimError)
        if aimErrors <= 3 then warn("BRM5 aim: " .. tostring(aimError)) end
    end
    local triggerOK, triggerError = pcall(updateTrigger, camera, current)
    if not triggerOK then
        recordError("Trigger update", triggerError)
        config.Trigger = false
        config.AutoEngage = false
        releaseMobileFire()
        warn("BRM5 triggerbot disabled: " .. tostring(triggerError))
        marker:SetAttribute("TriggerStatus", tostring(triggerError))
    end
    local retired = {}
    for actor in pairs(entries) do if not current[actor] then table.insert(retired, actor) end end
    for _, actor in ipairs(retired) do erase(entries[actor]); entries[actor] = nil end
    statusElapsed += dt
    if statusElapsed >= 0.5 then
        statusElapsed = 0
        local mode = isPVP() and "PvP: opposing Red/Blue team" or "Open world: player overlay"
        marker:SetAttribute("Frames", frames)
