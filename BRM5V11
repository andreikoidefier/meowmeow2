-- Only this script's errors are retained; no files or unrelated console logs are read.
local diagnosticStart = os.clock()
local diagnosticErrors, diagnosticByKey = {}, {}
local diagnosticTotal = 0
local function recordError(section, value, trace)
    local message = tostring(value):sub(1, 1800)
    local key = tostring(section) .. ": " .. message
    diagnosticTotal += 1
    local entry = diagnosticByKey[key]
    if entry then entry.count += 1; entry.last = os.clock() - diagnosticStart; return entry.count end
    if #diagnosticErrors >= 100 then
        local old = table.remove(diagnosticErrors, 1)
        diagnosticByKey[old.key] = nil
    end
    entry = {key=key, section=tostring(section), message=message, trace=tostring(trace or ""):sub(1, 2600), count=1, first=os.clock()-diagnosticStart, last=os.clock()-diagnosticStart}
    diagnosticByKey[key] = entry
    table.insert(diagnosticErrors, entry)
    return 1
end
local function safeCallback(section, callback)
    return function(...)
        local ok, result = xpcall(function(...) return table.pack(callback(...)) end, function(err)
            local trace = ""
            if type(debug.traceback) == "function" then trace = debug.traceback("", 2) end
            if recordError(section, err, trace) == 1 then warn("BRM5 " .. section .. ": " .. tostring(err)) end
            return err
        end, ...)
        if ok then return table.unpack(result, 1, result.n) end
        return nil
    end
end
local function formatErrorHistory()
    local lines = {string.format("Script error events: %d | retained groups: %d/100", diagnosticTotal, #diagnosticErrors)}
    for index, entry in ipairs(diagnosticErrors) do
        table.insert(lines, string.format("[%d] %.1fs–%.1fs | %s | repeats=%d\n%s\n%s", index, entry.first, entry.last, entry.section, entry.count, entry.message, entry.trace))
    end
    if #diagnosticErrors == 0 then table.insert(lines, "No script errors captured in this execution.") end
    return table.concat(lines, "\n")
end
