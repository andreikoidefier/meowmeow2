    if processed or Input:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.End then stop()
    elseif input.KeyCode == Enum.KeyCode.F7 then aimToggle:Set(not config.Aim)
    elseif input.KeyCode == Enum.KeyCode.RightShift and window and not window.unloaded then
        aimHeld = false; lockedActor = nil
        window:ToggleHide()
    end
end))

table.insert(connections, Input.WindowFocusReleased:Connect(function()
