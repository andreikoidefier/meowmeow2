local function moveAim(camera, screen, origin, factor)
    local ray = camera:ViewportPointToRay(screen.X, screen.Y)
    local look = ray.Direction
    local desiredYaw = math.atan2(-look.X, -look.Z)
    local desiredPitch = math.asin(math.clamp(look.Y, -1, 1))
    local controller = findAimCamera()
    if controller then
        -- Adjust the camera's existing angle state. BRM5 remains in charge of
        -- its camera, and releasing the bind leaves normal mouse control active.
        local yawError = (desiredYaw - controller._x + math.pi) % (2 * math.pi) - math.pi
        controller._x += yawError * factor
        controller._y = math.clamp(controller._y + (desiredPitch - controller._y) * factor,
            controller._yLimitDown or -1.4, controller._yLimitUp or 1.4)
        marker:SetAttribute("AimMethod", "BRM5 camera")
        return
    end
    if mobileDevice then
        local position = camera.CFrame.Position
        local previousLook = mobileAimLook or camera.CFrame.LookVector
        local result = CFrame.lookAt(position, position + previousLook):Lerp(CFrame.lookAt(position, position + look), factor)
        mobileAimLook = result.LookVector
        camera.CFrame = result
        marker:SetAttribute("AimMethod", "Mobile camera fallback")
        return
    end
    -- Fallback for a game update that changes the camera controller layout.
    local direction = camera.CFrame:VectorToObjectSpace(ray.Direction)
    local yaw = math.atan2(direction.X, -direction.Z)
    local pitch = math.atan2(-direction.Y, math.sqrt(direction.X * direction.X + direction.Z * direction.Z))
    local scale = aimSettings and (gameInput and gameInput.ADS
        and aimSettings.AimingSensitivity or aimSettings.CameraSensitivity) or 1
    local sensitivity = userSettings.MouseSensitivity * scale * (camera.FieldOfView / 70) / 100
    if sensitivity <= 0 then return end
    local movement = Vector2.new(yaw, pitch) / sensitivity * factor + mouseRemainder
    local dx, dy = math.round(movement.X), math.round(movement.Y)
    mouseRemainder = movement - Vector2.new(dx, dy)
    if dx ~= 0 or dy ~= 0 then mousemoverel(dx, dy) end
    marker:SetAttribute("AimMethod", "Native mouse")
end

