        marker:SetAttribute("Mode", mode)
        marker:SetAttribute("SettingsPath", select(2, window:GetPath()))
        marker:SetAttribute("AimEnabled", config.Aim)
        marker:SetAttribute("AimState", aimState)
        marker:SetAttribute("AimErrors", aimErrors)
        marker:SetAttribute("NoRecoil", config.NoRecoil)
        marker:SetAttribute("RecoilResets", recoilResets)
    end
end))
