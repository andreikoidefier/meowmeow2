local function updateNYCItems(camera, dt)
    local state = nycItemState
    if state.closed then return end
    if game.PlaceId ~= 4747446334 or not nyc.Items or not camera or not state.ready then
        for _, view in ipairs(state.pool) do view.frame.Visible = false end
        state.elapsed = 1
        marker:SetAttribute("NYCItemsSelected", 0)
        return
    end
    state.elapsed += dt
    state.textElapsed += dt
    local refreshText = state.textElapsed >= 0.25
    if refreshText then state.textElapsed = 0 end
    local localActor = replicator.LocalActor
    local origin = localActor and localActor.Position or camera.CFrame.Position
    if typeof(origin) ~= "Vector3" then origin = camera.CFrame.Position end
    if state.elapsed >= 0.75 then
        state.elapsed = 0
        local candidates, seen = {}, {}
        local inventory = state.inventory
        local total = 0
        for _, registry in ipairs({inventory._droppedItems, inventory._dropQueueByUID}) do
            for uid, drop in pairs(registry) do
                if not seen[uid] and type(drop) == "table" and typeof(drop.CFrame) == "CFrame" then
                    seen[uid] = true
                    total += 1
                    local item = drop.Item
                    if type(item) == "table" and type(item.Name) == "string" then
                        local price = state.prices[item.Name]
                        if type(item.MetaData) == "table" and item.MetaData.StoreBought then price = nil end
                        local support = nycSupportItems[item.Name]
                        local position = drop.CFrame.Position
                        local distance = (position - origin).Magnitude
                        -- The user's hard floor is strictly OVER $300. Unknown values and store-bought items are excluded.
                        if distance <= nyc.ItemRange and (nyc.AllGroundItems or nycSupportEnabled(support)
                            or (price and price > math.max(300, nyc.MinValue or 300))) then
                            local layout = item.Layout
                            local name = type(layout) == "table" and layout.Name or item.Name
                            table.insert(candidates, {
                                uid = uid, drop = drop, position = position, distance = distance,
                                name = support and support.name or tostring(name), price = price, support = support,
                            })
                        end
                    end
                end
            end
        end
        local livePrompts = 0
        for prompt in pairs(state.prompts) do
            local attachment = prompt.Parent
            if prompt.Enabled and attachment and attachment:IsA("Attachment") and attachment.Parent == terrain then
                livePrompts += 1
                local uid = attachment.Name
                if not seen[uid] then
                    seen[uid] = true
                    total += 1
                    local name = prompt.ActionText:match("^[Pp]ick up (.+)$") or prompt.ObjectText
                    if name == "" then name = "Ground item" end
                    local id = not state.ambiguousNames[name] and state.displayIDs[name] or nil
                    local price = id and state.prices[id]
                    local support = id and nycSupportItems[id]
                    local position = attachment.WorldPosition
                    local distance = (position - origin).Magnitude
                    if distance <= nyc.ItemRange and (nyc.AllGroundItems or nycSupportEnabled(support)
                        or (price and price > math.max(300, nyc.MinValue or 300))) then
                        table.insert(candidates, {uid = uid, prompt = prompt, attachment = attachment,
                            position = position, distance = distance, name = name, price = price, support = support})
                    end
                end
            end
        end
        marker:SetAttribute("NYCLivePickupObjects", livePrompts)
        table.sort(candidates, function(a, b)
            -- Useful access items stay visible even when a crowded loot area reaches the marker limit.
            if (a.support ~= nil) ~= (b.support ~= nil) then return a.support ~= nil end
            return a.distance < b.distance
        end)
        table.clear(state.entries)
        for i = 1, math.min(#candidates, math.clamp(nyc.ItemLimit or 60, 10, 120)) do
            state.entries[i] = candidates[i]
            nycItemView(i)
        end
        for i = #state.entries + 1, #state.pool do state.pool[i].frame.Visible = false end
        marker:SetAttribute("NYCItemsKnown", total)
        marker:SetAttribute("NYCItemsSelected", #state.entries)
        state.known = total
        refreshText = true
    end
    local inventory = state.inventory
    for index, entry in ipairs(state.entries) do
        local view = state.pool[index]
        local live, position
        if entry.prompt then
            live = entry.prompt.Parent == entry.attachment and entry.prompt.Enabled and entry.attachment.Parent == terrain
            position = live and entry.attachment.WorldPosition or entry.position
        else
            live = inventory._droppedItems[entry.uid] == entry.drop or inventory._dropQueueByUID[entry.uid] == entry.drop
            local cf = entry.drop.CFrame
            position = typeof(cf) == "CFrame" and cf.Position or entry.position
            local attachment = entry.drop.Attachment
            local prompt = typeof(attachment) == "Instance" and attachment:FindFirstChild("PickUp")
            if prompt and prompt:IsA("ProximityPrompt") and not prompt.Enabled then live = false end
        end
        local distance = (position - origin).Magnitude
        local projected, onScreen = camera:WorldToViewportPoint(position)
        view.frame.Visible = live and onScreen and projected.Z > 0 and distance <= nyc.ItemRange
            and (nyc.AllGroundItems or nycSupportEnabled(entry.support) or (entry.price and entry.price > math.max(300, nyc.MinValue or 300)))
        if view.frame.Visible then
            view.frame.Position = UDim2.fromOffset(projected.X, projected.Y)
            if view.lastColor ~= nyc.ItemColor then
                view.dot.BackgroundColor3 = nyc.ItemColor
                view.text.TextColor3 = nyc.ItemColor
                view.lastColor = nyc.ItemColor
            end
            if refreshText then
                view.text.TextSize = nyc.ItemTextSize or 14
                view.text.Size = UDim2.fromOffset(320, (nyc.ItemTextSize or 14) * 3.5)
                local priceText = nyc.ItemValues ~= false and entry.price and string.format(" | base $%d", entry.price) or ""
                local distanceText = nyc.ItemDistances ~= false and string.format("\n%d studs", math.floor(distance + 0.5)) or ""
                local hint = nyc.KeyHints ~= false and entry.support and "\n" .. entry.support.hint or ""
                local text = entry.name .. priceText .. distanceText .. hint
                if text ~= view.lastText then view.text.Text = text; view.lastText = text end
            end
        end
    end
end

