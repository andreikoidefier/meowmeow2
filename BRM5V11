local function aimOrigin(camera)
    if mobileDevice or Input.MouseBehavior == Enum.MouseBehavior.LockCenter then
        return camera.ViewportSize / 2
    end
    local inset = GuiService:GetGuiInset()
    return Input:GetMouseLocation() - inset
end

local function aimPosition(actor)
    local cf = actor.CFrame
    if typeof(cf) ~= "CFrame" then return nil end
    local partName = config.AimPart == "Head" and "Head" or "UpperTorso"
    local part = type(actor.Parts) == "table" and actor.Parts[partName]
    local root = actor.RootPart
    if typeof(part) == "Instance" and part:IsA("BasePart")
        and typeof(root) == "Instance" and root:IsA("BasePart") then
        -- BRM5 parks culled rigs at Y=-500. Rebase a valid pose onto the
        -- replicated actor transform instead of using the parked world position.
        local offset = root.CFrame:PointToObjectSpace(part.Position)
        if offset.Magnitude < 8 then return cf:PointToWorldSpace(offset) end
    end
    -- A rig can have a moved root but stale bones during LOD transitions.
    -- Use its replicated stance until its skeletal pose is usable again.
    local head = config.AimPart == "Head"
    local y = actor.HeightState == 2 and (head and 0.25 or 0)
        or actor.HeightState == 1 and (head and 1.25 or 0.45)
        or (head and 2.25 or 0.65)
    local forward = actor.HeightState == 2 and (head and 1.5 or 0.5) or 0
    return cf:PointToWorldSpace(Vector3.new(0, y, -forward))
end

local aimRejected: {[string]: number} = {}
local aimBlocker: any = "none"
local function rejectAim(reason)
    aimRejected[reason] = (aimRejected[reason] or 0) + 1
    return nil
end
local function appendLocalViewmodel(ignore)
    local actor = replicator.LocalActor
    local view = actor and actor.ViewModel
    if type(view) ~= "table" then return end
    for _, value in pairs(view) do
        if typeof(value) == "Instance" and (value:IsA("Model") or value:IsA("BasePart") or value:IsA("WorldModel")) then
            table.insert(ignore, value)
        end
    end
end
local function aimCandidate(actor, camera, origin)
    local owner = actor.Owner
    if typeof(owner) ~= "Instance" or not owner:IsA("Player") then return rejectAim("not-player") end
    if not targetAllowed(actor) then return rejectAim("filtered-or-dead") end
    if config.AutoEngage and not autoEngageEnemy(actor) then return rejectAim("not-enemy") end
    local point = aimPosition(actor)
    if not point then return rejectAim("no-position") end
    if (point - camera.CFrame.Position).Magnitude > config.AimDistance then return rejectAim("out-of-range") end
    local projected, onScreen = camera:WorldToViewportPoint(point)
    if not onScreen or projected.Z <= 0 then return rejectAim("offscreen") end
    local screen = Vector2.new(projected.X, projected.Y)
    local distance = (screen - origin).Magnitude
    if distance > config.AimRadius then return rejectAim("outside-circle") end
    if config.AimVisible or config.AutoEngage then
        local hit = workspace:Raycast(camera.CFrame.Position, point - camera.CFrame.Position, aimRay)
        if hit then
            local character = actor.Character
            if typeof(character) ~= "Instance"
                or not (hit.Instance == character or hit.Instance:IsDescendantOf(character)) then
                aimBlocker = hit.Instance
                return rejectAim("blocked")
            end
        end
    end
    aimRejected.accepted = (aimRejected.accepted or 0) + 1
    return screen, distance
end

local function updateAim(camera, dt, current)
    aimCircle.Visible = false
    if not camera then lockedActor = nil; mobileAimLook = nil; aimState = "No camera"; return end
    local origin = aimOrigin(camera)
    local active = isrbxactive() and not Input:GetFocusedTextBox()
    aimCircle.Position = UDim2.fromOffset(origin.X, origin.Y)
    aimCircle.Size = UDim2.fromOffset(config.AimRadius * 2, config.AimRadius * 2)
    aimCircle.Visible = config.AimCircle and active
    aimCircleStroke.Color = Color3.fromRGB(255, 210, 110)
    if not (config.Aim or config.AutoEngage) then
        lockedActor = nil; mobileAimLook = nil; aimState = "Disabled"; return
    end
    aimHeld = aimButtonDown()
    marker:SetAttribute("AimHeld", aimHeld)
    marker:SetAttribute("AimPhysical", aimHeld)
    if not active or not aimHeld
        or (gameInput and (gameInput.PauseOpen or gameInput.InventoryOpen or gameInput.RadialOpen))
        or type(replicator.LocalActor) ~= "table"
        or replicator.LocalActor.Alive == false
        or (type(replicator.LocalActor.Health) == "number" and replicator.LocalActor.Health <= 0) then
        lockedActor = nil
        mouseRemainder = Vector2.zero
        mobileAimLook = nil
        aimState = not active and "Window unfocused or typing" or "Ready: press aim key"
        return
    end
    local ignore = {camera}
    -- Visibility tests concern map cover. Render rigs can live in WorldModels;
    -- exclude their visual copies and test the replicated world point.
    for actor in pairs(current) do
        if typeof(actor.Character) == "Instance" then table.insert(ignore, actor.Character) end
    end
    for _, character in ipairs({replicator.LocalActor.Character or false, player.Character or false}) do
        if typeof(character) == "Instance" then table.insert(ignore, character) end
    end
    appendLocalViewmodel(ignore)
    aimRay.FilterDescendantsInstances = ignore
    aimRejected, aimBlocker = {}, "none"
    local screen
    if lockedActor and current[lockedActor] then
        screen = aimCandidate(lockedActor, camera, origin)
    end
    if not screen then
        lockedActor = nil
        local best = config.AimRadius
        for actor in pairs(current) do
            local candidate, distance = aimCandidate(actor, camera, origin)
            if candidate and distance < best then
                lockedActor, screen, best = actor, candidate, distance
            end
        end
    end
    if not screen then
        mobileAimLook = nil
        aimState = config.AutoEngage and (not isPVP() and "Auto engage: PvP mode not identified" or "Auto engage: no visible opposing-team player") or "No visible player in circle"
        return
    end
    aimState = "Locked: " .. lockedActor.Owner.DisplayName
    local delta = screen - origin
    local factor = config.AimSmooth <= 1 and 1
        or (1 - math.pow(1 - 1 / config.AimSmooth, math.clamp(dt, 0, 1 / 20) * 60))
    if config.AutoEngage then
        local _, _, response = autoEngageTiming(config.AutoEngageSpeed)
        factor = 1 - math.exp(-math.min(dt, 0.05) * response)
    elseif mobileDevice then factor = math.min(factor, 1 - math.exp(-math.min(dt, 0.05) * 18)) end
    marker:SetAttribute("AimDelta", delta.Magnitude)
    aimCircleStroke.Color = Color3.fromRGB(80, 255, 130)
    if delta.Magnitude > 1 then
        moveAim(camera, screen, origin, factor)
        marker:SetAttribute("AimMoves", (marker:GetAttribute("AimMoves") or 0) + 1)
    else
        mouseRemainder = Vector2.zero
    end
end


local triggerActor
local triggerSince, lastShot = 0, 0
local triggerRay = RaycastParams.new()
triggerRay.FilterType = Enum.RaycastFilterType.Exclude
triggerRay.IgnoreWater = true
local function triggerPoint(actor, head)
    local cf = actor.CFrame
    if typeof(cf) ~= "CFrame" then return nil end
    local part = type(actor.Parts) == "table" and actor.Parts[head and "Head" or "UpperTorso"]
    local root = actor.RootPart
    if typeof(part) == "Instance" and part:IsA("BasePart") and typeof(root) == "Instance" and root:IsA("BasePart") then
        local offset = root.CFrame:PointToObjectSpace(part.Position)
        if offset.Magnitude < 8 then return cf:PointToWorldSpace(offset) end
    end
    local y = actor.HeightState == 2 and (head and 0.25 or 0)
        or actor.HeightState == 1 and (head and 1.25 or 0.45) or (head and 2.25 or 0.65)
    return cf:PointToWorldSpace(Vector3.new(0, y, actor.HeightState == 2 and -1 or 0))
end
-- Use the game's currently mounted fire callback; never scan the heap to shoot.
local mobileFireBusy, mobileRelease
local function releaseMobileFire()
    local callback = mobileRelease
    mobileRelease = nil
    if callback then task.defer(function() pcall(callback, false) end) end
end
mobileFireCleanup = releaseMobileFire
local function mobileTriggerShot()
    if mobileFireBusy or mobileRelease then return false end
    local actor = replicator.LocalActor
    if not actor or actor.Sprinting or actor.Sliding or actor.Downed then return false end
    if config.FarmAutoFire then return false end
    local mounts = gameInput and gameInput._mounts
    local callback = type(mounts) == "table" and mounts.Discharge
    if type(callback) ~= "function" then
        marker:SetAttribute("TriggerStatus", "No active firearm input binding")
        return false
    end
    mobileFireBusy = true
    task.defer(function()
        if stopped or not (config.Trigger or config.AutoEngage) or not triggerActor or mounts.Discharge ~= callback
            or (config.AutoEngage and (triggerActor ~= lockedActor or not autoEngageEnemy(triggerActor))) then mobileFireBusy = false; return end
        mobileRelease = callback
        task.delay(0.06, function()
            if mobileRelease == callback then releaseMobileFire() end
        end)
        local ok, err = pcall(callback, true)
        if mobileRelease == callback then releaseMobileFire() end
        mobileFireBusy = false
        if not ok and not stopped then
            config.Trigger = false
            config.AutoEngage = false
            recordError("Mobile fire", err)
            marker:SetAttribute("TriggerLastError", tostring(err))
            warn("BRM5 mobile trigger paused: " .. tostring(err))
        end
    end)
    return true
end
local triggerNextUpdate = 0
local function updateTrigger(camera, current)
    if mobileDevice and os.clock() < triggerNextUpdate then return end
    triggerNextUpdate = os.clock() + 0.05
    if not (config.Trigger or config.AutoEngage) or not camera or not isrbxactive() or Input:GetFocusedTextBox()
        or (gameInput and (gameInput.PauseOpen or gameInput.InventoryOpen or gameInput.RadialOpen))
        or (not mobileDevice and Input.MouseEnabled and Input.MouseBehavior ~= Enum.MouseBehavior.LockCenter)
        or type(replicator.LocalActor) ~= "table" or replicator.LocalActor.Alive == false then
        triggerActor = nil
        releaseMobileFire()
        local reason = not (config.Trigger or config.AutoEngage) and "Disabled"
            or not camera and "No camera"
            or not isrbxactive() and "Window unfocused"
            or Input:GetFocusedTextBox() and "Text box focused"
            or (gameInput and (gameInput.PauseOpen or gameInput.InventoryOpen or gameInput.RadialOpen)) and "Game menu open"
            or (type(replicator.LocalActor) ~= "table" or replicator.LocalActor.Alive == false) and "Not spawned / not alive"
            or "Mouse not locked"
        marker:SetAttribute("TriggerStatus", reason)
        return
    end
    if not mobileDevice and type(mouse1click) ~= "function" then
        marker:SetAttribute("TriggerStatus", "Executor has no mouse1click support")
        return
    end
    -- Do not release or interrupt a button the user is holding to fire manually.
    if not mobileDevice and Input:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then return end
    local origin2 = camera.ViewportSize / 2
    local ray = camera:ViewportPointToRay(origin2.X, origin2.Y)
    local ignore = {camera}
    for actor in pairs(current) do
        if typeof(actor.Character) == "Instance" then table.insert(ignore, actor.Character) end
    end
    appendLocalViewmodel(ignore)
    triggerRay.FilterDescendantsInstances = ignore
    local best, bestDistance = nil, config.TriggerRange
    for actor in pairs(current) do
        if (not config.AutoEngage or (actor == lockedActor and autoEngageEnemy(actor)))
            and targetAllowed(actor) and typeof(actor.Owner) == "Instance" and actor.Owner:IsA("Player") then
            for _, head in ipairs({true, false}) do
                if (config.AutoEngage and config.AimPart == (head and "Head" or "Chest"))
                    or (not config.AutoEngage and (config.TriggerPart == "Both" or config.TriggerPart == (head and "Head" or "Chest"))) then
                    local point = triggerPoint(actor, head)
                    if point then
                        local along = (point - ray.Origin):Dot(ray.Direction)
                        local radius = head and 0.45 or 0.7
                        if along > 0 and along < bestDistance
                            and (point - (ray.Origin + ray.Direction * along)).Magnitude < radius
                            and not workspace:Raycast(ray.Origin, point - ray.Origin, triggerRay) then
                            best, bestDistance = actor, along
                        end
                    end
                end
            end
        end
    end
    local now = os.clock()
    if best ~= triggerActor then triggerActor, triggerSince = best, now end
    if not best then releaseMobileFire(); marker:SetAttribute("TriggerStatus", "No visible target under crosshair"); return end
    marker:SetAttribute("TriggerStatus", "Target acquired")
    local delay, interval
    if config.AutoEngage then delay, interval = autoEngageTiming(config.AutoEngageSpeed)
    else delay, interval = math.max(config.TriggerDelay / 1000, mobileDevice and 0.15 or 0), math.max(config.TriggerInterval / 1000, mobileDevice and 0.2 or 0) end
    if now - triggerSince >= delay and now - lastShot >= interval then
        lastShot = now
        if mobileDevice then
            if not mobileTriggerShot() then return end
        else
            mouse1click()
        end
        marker:SetAttribute("TriggerShots", (marker:GetAttribute("TriggerShots") or 0) + 1)
    end
end

