local nycRuntime = (function()
-- Scoped wall passage for NYC flight. Native floor collision and safe exit remain required.
local nycNoclip = (function()
    local pending = false
    local overlap = OverlapParams.new()
    local lastClearPosition
    local queryPart
    local function status(value)
        if marker:GetAttribute("NYCNoclipStatus") ~= value then marker:SetAttribute("NYCNoclipStatus", value) end
        marker:SetAttribute("NYCNoclipActive", nyc.Noclip == true and nyc.Fly == true)
    end
    local function worldPosition(controller)
        if controller._groundHitbox then return controller._groundHitbox.CFrame:PointToWorldSpace(controller._position) end
        return controller._position
    end
    local function clear(controller, atPosition)
        if type(controller) ~= "table" or not controller._params then return false end
        local position = atPosition or worldPosition(controller)
        if typeof(position) ~= "Vector3" then return false end
        local params = controller._params
        overlap.FilterType = params.FilterType
        overlap.FilterDescendantsInstances = params.FilterDescendantsInstances
        overlap.CollisionGroup = params.CollisionGroup
        overlap.RespectCanCollide = false
        overlap.MaxParts = 1
        -- Leave a gap above the feet so an ordinary flat floor does not block exit.
        local height = math.max((tonumber(controller._hullHeight) or 6) - 0.6, 1)
        local parts = workspace:GetPartBoundsInBox(CFrame.new(position), Vector3.new(2.6, height, 2.6), overlap)
        local free = #parts == 0
        if not free then
            -- Mesh bounding boxes cover empty rooms too. Confirm actual overlap before refusing exit.
            if not queryPart or not queryPart.Parent then
                queryPart = Instance.new("Part")
                queryPart.Name = "BRM5_Noclip_ClearanceProbe"
                queryPart.Anchored = true
                queryPart.Transparency = 1
                queryPart.CanCollide = false
                queryPart.CanTouch = false
                queryPart.CanQuery = false
                queryPart.Parent = workspace.CurrentCamera
            end
            queryPart.Size = Vector3.new(2.6, height, 2.6)
            queryPart.CFrame = CFrame.new(position)
            free = #workspace:GetPartsInPart(queryPart, overlap) == 0
        end
        if free then lastClearPosition = position end
        return free
    end
    local function requestDisable(controller)
        if not nyc.Noclip then pending = false; status("Off"); return true end
        if nyc.Fly and controller and not clear(controller) then
            pending = true
            status("Move clear of the wall to switch noclip off")
            return false
        end
        nyc.Noclip = false
        pending = false
        status("Off")
        return true
    end
    local function finishExit(controller)
        if not pending then return not nyc.Noclip end
        return requestDisable(controller)
    end
    local function setEnabled(enabled)
        if enabled == true then
            if game.PlaceId ~= 4747446334 then status("NYC zombies only"); return false end
            pending = false
            nyc.Noclip = true
            status(nyc.Fly and "Wall passage enabled · floors remain solid" or "Ready · enable Fly to use noclip")
            return true
        end
        local actor = replicator.LocalActor
        return requestDisable(actor and actor.Controller)
    end
    local function resolve(controller, desired)
        local previous = worldPosition(controller)
        local half = math.max((tonumber(controller._hullHeight) or 6) / 2, 1.55)
        local grounded, normal = false, Vector3.yAxis
        -- Only a floor at or below the old feet can stop descending/level movement.
        -- This does not treat an upper storey or the top of a wall as a landing.
        if desired.Y <= previous.Y + 0.001 then
            local castFrom = Vector3.new(desired.X, previous.Y + 0.25, desired.Z)
            local length = half + math.max(previous.Y - desired.Y, 0) + 0.55
            local hit = workspace:Raycast(castFrom, Vector3.new(0, -length, 0), controller._params)
            if hit and hit.Normal.Y >= 0.5 and hit.Position.Y <= previous.Y - half + 0.35 then
                local floorY = hit.Position.Y + half + 0.05
                if desired.Y <= floorY + 0.13 then
                    desired = Vector3.new(desired.X, math.max(desired.Y, floorY), desired.Z)
                    grounded = true
                    normal = hit.Normal
                end
            end
        end
        return desired, grounded, normal, nil, nil
    end
    local elapsed = 0
    table.insert(connections, RunService.Heartbeat:Connect(function(dt)
        if stopped then return end
        elapsed += dt
        if elapsed < 0.1 or not pending then return end
        elapsed = 0
        local actor = replicator.LocalActor
        if not actor or not actor.Alive then nyc.Noclip = false; pending = false; status("Off"); return end
        finishExit(actor.Controller)
    end))
    return {
        resolve = resolve, clear = clear, setEnabled = setEnabled,
        requestDisable = requestDisable, finishExit = finishExit,
        updateStatus = function()
            if pending then status("Move clear of the wall to switch noclip off")
            elseif nyc.Noclip and nyc.Fly then status("On · floors remain solid")
            elseif nyc.Noclip then status("Ready · enable Fly to use noclip")
            else status("Off") end
        end,
        cleanup = function()
            pending = false; nyc.Noclip = false; lastClearPosition = nil
            if queryPart then queryPart:Destroy(); queryPart=nil end
            status("Off")
        end,
    }
end)()

-- NYC custom-controller flight with a slow landing handoff.
-- setEnabled(false) requests landing; release() is immediate cleanup only.
local nycFlight: any = {controller=nil, original=nil, priorRaw=nil, wrapper=nil, priorProcess=nil, processWrapper=nil,
    velocity=Vector3.zero, pending=false, groundedTime=0, lastStatus=nil, landAfterExit=false}

local function flightStatus(text)
    if nycFlight.lastStatus ~= text then
        nycFlight.lastStatus = text
        marker:SetAttribute("NYCFlightStatus", text)
    end
end

local function flightWorldPosition(controller)
    if controller._groundHitbox then
        return controller._groundHitbox.CFrame:PointToWorldSpace(controller._position)
    end
    return controller._position
end

local function flightFloor(controller, position)
    local half = math.max((tonumber(controller._hullHeight) or 6) / 2, 1.55)
    local hit = workspace:Raycast(position + Vector3.new(0, 0.25, 0), Vector3.new(0, -(half + 30.25), 0), controller._params)
    if hit and hit.Normal.Y >= 0.5 then
        return math.max(0, position.Y - hit.Position.Y - half), hit
    end
    return nil, nil
end

function nycFlight.release()
    local controller = nycFlight.controller
    if controller then
        if rawget(controller, "Update") == nycFlight.wrapper then rawset(controller, "Update", nycFlight.priorRaw) end
        if rawget(controller,"_processNewPosition") == nycFlight.processWrapper then rawset(controller,"_processNewPosition",nycFlight.priorProcess) end
        controller.VelocityGravity = 0
        controller.MoveSpeed = 0
        controller._lastMovement = Vector2.zero
    end
    nycFlight.controller, nycFlight.original, nycFlight.priorRaw, nycFlight.wrapper = nil, nil, nil, nil
    nycFlight.processWrapper, nycFlight.priorProcess = nil, nil
    nycFlight.landAfterExit = false
    nycFlight.velocity = Vector3.zero
    nycFlight.pending, nycFlight.groundedTime = false, 0
    nyc.Vertical = 0
    marker:SetAttribute("NYCFlightActive", false)
end

function nycFlight.setEnabled(enabled)
    nyc.Fly = enabled == true and (game.PlaceId == 4747446334 or game.PlaceId == 10938546013 or game.PlaceId == 5468388011)
    nyc.Vertical = 0
    nycFlight.groundedTime = 0
    if nyc.Fly then
        nycFlight.landAfterExit = false
        nycFlight.pending = false
        flightStatus("Flying")
    elseif nycFlight.controller then
        if nyc.Noclip and not nycNoclip.clear(nycFlight.controller) then
            nyc.Fly = true
            nycFlight.landAfterExit = true
            flightStatus("Move clear of the wall to finish landing")
            return
        end
        nycFlight.pending = true
        nycFlight.velocity = Vector3.zero
        flightStatus("Landing... press F to resume flight")
    else
        nycFlight.release()
        flightStatus("Off")
    end
end

function nycFlight.install(controller)
    if nycFlight.controller == controller then return end
    local pending = nycFlight.pending
    nycFlight.release()
    nycFlight.pending = pending
    if type(controller) ~= "table" or type(controller.Update) ~= "function"
        or type(controller._processNewPosition) ~= "function" then return end
    nycFlight.controller, nycFlight.original = controller, controller.Update
    nycFlight.priorRaw = rawget(controller, "Update")
    local original = controller.Update
    local originalProcess = controller._processNewPosition
    nycFlight.priorProcess = rawget(controller,"_processNewPosition")
    nycFlight.processWrapper = function(self, desired, ...)
        local actor = replicator.LocalActor
        if not stopped and nyc.Noclip and nyc.Fly and not nycFlight.pending
            and actor and actor.Controller == self and actor.Alive and not actor.Forced
            and not actor.Seat and not actor.OldSeat and not actor.Downed
            and not actor.Ladder and not actor.Rappelling and not actor._vehicleEjection
            and not actor.Frozen and not self.Goal and not self._forceCFrame
            and not (actor.CurrentState and (actor.CurrentState.Dragged or actor.CurrentState.Dragging)) then
            return nycNoclip.resolve(self,desired)
        end
        return originalProcess(self,desired,...)
    end
    rawset(controller,"_processNewPosition",nycFlight.processWrapper)
    nycFlight.wrapper = function(self, nativeMovement, dt)
        local actor = replicator.LocalActor
        if stopped or not (nyc.Fly or nycFlight.pending) or (game.PlaceId ~= 4747446334 and game.PlaceId ~= 10938546013 and game.PlaceId ~= 5468388011)
            or not actor or actor.Controller ~= self or not actor.Alive
            or actor.Downed or actor.Seat or actor.OldSeat or actor.Forced
            or actor.Rappelling or actor.Ladder or actor._vehicleEjection
            or actor.Frozen or self.Goal or self._forceCFrame
            or (actor.CurrentState and (actor.CurrentState.Dragged or actor.CurrentState.Dragging)) then
            nycFlight.velocity = Vector3.zero
            return original(self, nativeMovement, dt)
        end
        if type(dt) ~= "number" or dt <= 0 then return original(self, nativeMovement, dt) end
        local ok, err = pcall(function()
            if nycFlight.landAfterExit and nycNoclip.clear(self) then
                nycFlight.landAfterExit=false;nyc.Fly=false;nycFlight.pending=true
                nycFlight.velocity=Vector3.zero
            end
            local step = math.min(dt, 0.05)
            local position = flightWorldPosition(self)
            local gap = flightFloor(self, position)
            -- Only native ground contact PLUS a real downward floor hit qualifies.
            -- _processNewPosition can also return grounded=true when a wall shapecast fails.
            if nycFlight.pending and self.IsGrounded == true and gap and gap <= 0.18 then
                self.VelocityGravity = 0
                self.MoveSpeed = 0
                self._lastMovement = Vector2.zero
                original(self, Vector2.zero, math.min(dt, 1/60))
                local nativePosition = flightWorldPosition(self)
                local nativeGap = flightFloor(self, nativePosition)
                if self.IsGrounded == true and nativeGap and nativeGap <= 0.18 then
                    nycFlight.groundedTime += step
                    flightStatus("Grounded — finishing landing")
                    if nycFlight.groundedTime >= 0.4 then
                        nycFlight.release()
                        flightStatus("Grounded")
                    end
                    return
                end
                nycFlight.groundedTime = 0
                position = nativePosition
            else
                nycFlight.groundedTime = 0
            end
            if self._groundHitbox then
                self._position = position
                self._groundHitbox, self._groundTimer, actor.Platform = nil, nil, nil
            end
            self.VelocityGravity, self.MoveSpeed = 0, 0
            self._lastMovement = Vector2.zero
            self.IsSliding, self.TrySprinting = false, false
            -- A stalled frame must not create a native Falling state from fake gravity.
            original(self, Vector2.zero, math.min(dt, 1/60))
            position = flightWorldPosition(self)
            if self._groundHitbox then
                self._groundHitbox, self._groundTimer, actor.Platform = nil, nil, nil
            end
            self._position = position
            gap = flightFloor(self, position)
            local speed = math.clamp(tonumber(nyc.Speed) or 30, 5, 120)
            local blocked = Input:GetFocusedTextBox() ~= nil
                or (gameInput and (gameInput.PauseOpen or gameInput.InventoryOpen or gameInput.RadialOpen))
            local targetVelocity = Vector3.zero
            if nycFlight.pending then
                if not blocked then
                    local descent = gap and math.clamp(gap * 2.5, 0.6, 8) or 8
                    targetVelocity = Vector3.new(0, -descent, 0)
                end
                flightStatus(blocked and "Landing paused — close the game menu" or "Landing... press F to resume flight")
            else
                local camera = workspace.CurrentCamera
                if camera and not blocked then
                    local axes = typeof(nativeMovement) == "Vector2" and nativeMovement or Vector2.zero
                    local move = camera.CFrame.RightVector * axes.X - camera.CFrame.LookVector * axes.Y
                    local vertical = nyc.Vertical or 0
                    if Input:IsKeyDown(Enum.KeyCode.Space) or Input:IsKeyDown(Enum.KeyCode.E) then vertical += 1 end
                    if Input:IsKeyDown(Enum.KeyCode.LeftControl) or Input:IsKeyDown(Enum.KeyCode.Q) then vertical -= 1 end
                    if Input.TouchEnabled and self._up then vertical += 1 end
                    move += Vector3.yAxis * math.clamp(vertical, -1, 1)
                    if move.Magnitude > 1 then move = move.Unit end
                    targetVelocity = move * speed
                    if targetVelocity.Y < 0 then
                        local descentLimit = gap and math.clamp(gap * 2.5, 0.6, 8) or 30
                        targetVelocity = Vector3.new(targetVelocity.X, math.max(targetVelocity.Y, -descentLimit), targetVelocity.Z)
                    end
                end
                flightStatus(nycFlight.landAfterExit and "Move clear of the wall to finish landing" or (nyc.Noclip and "Flying · noclip" or "Flying"))
            end
            nycFlight.velocity = nycFlight.velocity:Lerp(targetVelocity, 1-math.exp(-14*step))
            -- Clamp actual downward velocity too; deceleration must start before floor contact.
            local limit = gap and math.clamp(gap * 2.5, 0.6, 8) or (nycFlight.pending and 8 or 30)
            if nycFlight.velocity.Y < -limit then
                nycFlight.velocity = Vector3.new(nycFlight.velocity.X, -limit, nycFlight.velocity.Z)
            end
            if nycFlight.velocity.Magnitude < 0.03 then nycFlight.velocity = Vector3.zero end
            self._lastSafePosition = position
            local resolved, grounded, normal = self:_processNewPosition(position + nycFlight.velocity * step)
            if typeof(resolved) ~= "Vector3" or resolved.X ~= resolved.X
                or (resolved-position).Magnitude > speed*step+3 then
                resolved = position
                nycFlight.velocity = Vector3.zero
            end
            local realGap = flightFloor(self, resolved)
            local onFloor = grounded == true and realGap ~= nil and realGap <= 0.18
            self._position, self._lastSafePosition, self._correctedPosition = resolved, resolved, resolved
            self.VelocityGravity, self.MoveSpeed = 0, 0
            self._lastMovement = Vector2.zero
            self.IsSliding, self.IsSprinting = false, false
            self.IsGrounded = onFloor
            if onFloor and typeof(normal)=="Vector3" then self.SlopeNormal=normal end
            actor.Sprinting, actor.Sliding, actor.Grounded = false, false, onFloor
            actor.SimulatedPosition = resolved
            marker:SetAttribute("NYCFlightPosition", resolved)
            marker:SetAttribute("NYCFlightActive", true)
        end)
        if not ok then
            recordError("NYC flight", err)
            marker:SetAttribute("NYCFlightError", tostring(err))
            flightStatus("Flight error — "..tostring(err))
            nyc.Fly = false
            nycFlight.release()
            return original(self, nativeMovement, dt)
        end
        return nil
    end
    rawset(controller, "Update", nycFlight.wrapper)
end

table.insert(connections, RunService.Heartbeat:Connect(function()
    if stopped then return end
    local actor = replicator.LocalActor
    if not (nyc.Fly or nycFlight.pending) or (game.PlaceId ~= 4747446334 and game.PlaceId ~= 10938546013 and game.PlaceId ~= 5468388011) or not actor or not actor.Alive then
        if nycFlight.controller then nycFlight.release() end
        marker:SetAttribute("NYCFlightActive", false)
    elseif actor.Controller ~= nycFlight.controller then
        nycFlight.install(actor.Controller)
    end
end))

