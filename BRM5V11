                local folder = shared and shared:FindFirstChild("Inventory")
                local layoutModule = folder and folder:FindFirstChild("ItemLayout")
                if not layoutModule then return end
                local layouts = require(layoutModule)
                local count = 0
                for id, layout in pairs(layouts) do
                    if type(id) == "string" and type(layout) == "table" and type(layout.Name) == "string" then
                        local name = layout.Name
                        if nycItemState.displayIDs[name] and nycItemState.displayIDs[name] ~= id then
                            nycItemState.ambiguousNames[name] = true
                        else
                            nycItemState.displayIDs[name] = id
                        end
                    end
                    count += 1
                    if count % 500 == 0 then task.wait() end
                end
            end)
            if not lookupOK then recordError("NYC pickup name lookup", lookupError) end
            while not stopped and not nycItemState.closed do
                for _, candidate in ipairs(filtergc("table", {Keys = {"_droppedItems", "_dropQueueByUID"}})) do
                    if type(rawget(candidate, "_droppedItems")) == "table"
                        and type(rawget(candidate, "_dropQueueByUID")) == "table"
                        and type(candidate._queueDroppedItem) == "function" then
                        nycItemState.inventory = candidate
                        nycItemState.ready = next(nycItemState.prices) ~= nil
                        return
                    end
                end
                task.wait(4)
            end
        end)
        if not ok and not stopped then recordError("NYC item discovery", err) end
    end)
end

