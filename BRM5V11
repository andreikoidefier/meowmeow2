    if stopped then return end
    if window.unloaded then stop(); return end
    applyFullbright()
    nycRuntime.updateItems(workspace.CurrentCamera, dt)
    frames += 1
    applyNoFog()
    drawn, eligible = 0, 0
    for _, entry in pairs(entries) do hide(entry) end
    local camera = workspace.CurrentCamera
    local current = {}
    for _, actor in pairs(replicator.Actors) do
        current[actor] = true
        if config.Enabled and camera and targetAllowed(actor) then
            eligible += 1
            local entry = entries[actor]
            if not entry then entry = newEntry(); entries[actor] = entry end
            local ok, visible = pcall(updateActor, actor, entry, camera)
            if not ok then
                hide(entry)
                recordError("ESP draw", visible)
                errors += 1
                if errors <= 3 then warn("BRM5 ESP draw: " .. tostring(visible)) end
            elseif visible then drawn += 1 end
        end
    end
    local aimOK, aimError = pcall(updateAim, camera, dt, current)
    if not aimOK then
        aimHeld = false; lockedActor = nil; aimCircle.Visible = false
        if config.AutoEngage then releaseMobileFire() end
