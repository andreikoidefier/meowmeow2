    elseif farmWeapon:_isAimingAtProtectedActor() then reason = "Paused: crosshair points at a protected NPC"
    end
    if not reason then
        if farmWeapon._reloading then
            reason = "Reloading"
        elseif not farmWeapon._mag or farmWeapon._mag.Capacity <= 0 then
            stopFarmFire()
            reason = spareCount == 0 and "Out of ammunition: resupply magazines" or (config.FarmAutoReload and "Reloading / checking spare magazines" or "Empty: reload or enable automatic reload")
            if config.FarmAutoReload and spareCount > 0 and not farmWeapon._reloading and os.clock() >= farmReloadNext then
