-- NYC evacuation: server clock, active official markers, and native flare origins.
-- The public Survival guide lists 20:00. This is an estimate, never a server ETA.
local function createNYCLiveText(tab, title, initial)
    local card = tab:CreateText({name = title, text = initial})
    local body = card and card.body
    if typeof(body) == "Instance" and body:IsA("TextLabel") then
        body.AutomaticSize = Enum.AutomaticSize.Y
        local last = initial
        return function(value)
            if stopped or not body.Parent or value == last then return end
            last = value
            body.Text = value
        end, card
    end
    return function() end, card
end

local nycEvac = (function()
    local state = {closed = false, server = nil, tag = nil, map = nil, position = nil,
        label = nil, source = nil, elapsed = 1, lastClock = nil, lastTime = nil,
        clockRate = nil, clockSamples = 0, setText = nil, setClockText = nil, frame = nil, diamond = nil,
        line = nil, arrow = nil, text = nil, lastText = nil}
    local lighting = game:GetService("Lighting")

    local function isExtraction(value)
        local text = tostring(value or ""):lower()
        return text:find("extract", 1, true) ~= nil or text:find("exfil", 1, true) ~= nil
            or text:find("evac", 1, true) ~= nil
    end

    local function findServices()
        for _, candidate in ipairs(filtergc("table", {Keys = {"GLOBAL_SELLER", "ZOMBIES_PVP_RULES"}}, false)) do
            if type(candidate.GLOBAL_SELLER) == "string" then state.server = candidate; break end
        end
        for _, candidate in ipairs(filtergc("table", {Keys = {"_markers", "_spottedTimers"}}, false)) do
            if type(candidate._markers) == "table" then state.tag = candidate; break end
        end
        for _, candidate in ipairs(filtergc("table", {Keys = {"Markers", "_serverMarkers", "_localMarkers"}}, false)) do
            if type(candidate.Markers) == "table" then state.map = candidate; break end
        end
    end

    local function discoverPickup()
        local origin = replicator.LocalActor and replicator.LocalActor.Position
        if typeof(origin) ~= "Vector3" then origin = workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position or Vector3.zero end
        local best, bestLabel, bestSource, distance
        local function consider(position, label, source)
            if typeof(position) ~= "Vector3" then return end
            local d = (position - origin).Magnitude
            if not distance or d < distance then best, bestLabel, bestSource, distance = position, label, source, d end
        end
        for _, registry in ipairs({state.tag and state.tag._markers or {}, state.map and state.map.Markers or {}}) do
            for key, info in pairs(registry) do
                if type(info) == "table" and (isExtraction(key) or isExtraction(info.Text) or isExtraction(info.Type)) then
                    consider(info.Position, tostring(info.Text or "Evac pickup"), "Server marker")
                end
            end
        end
        if not best then
            -- FlareBallPrefab lifts the visible ball 2000 studs into the sky.
            -- Its native _origin is the signal launch position; never waypoint the sky ball.
            for _, flare in ipairs(filtergc("table", {Keys = {"_origin", "_ball", "_start"}}, false)) do
                local ball, originCF = rawget(flare, "_ball"), rawget(flare, "_origin")
                if typeof(ball) == "Instance" and ball:IsA("BasePart") and ball:IsDescendantOf(workspace)
                    and typeof(originCF) == "CFrame" and ball:GetAttribute("LensFlareStyle") == "SmallWithFlare" then
                    local color = ball:GetAttribute("LensFlareColor")
                    if typeof(color) == "Color3" and color.R > 0.8 and color.G < 0.3 and color.B < 0.3 then
                        consider(originCF.Position, "Evac pickup · red flare", "Red flare origin")
                    end
                end
            end
        end
        state.position, state.label, state.source = best, bestLabel, bestSource
    end

    if game.PlaceId == 4747446334 then
        task.spawn(function()
            local ok, err = pcall(function()
                findServices()
                while not stopped and not state.closed do
                    discoverPickup()
                    task.wait(3)
                end
            end)
            if not ok and not stopped then recordError("NYC evacuation discovery", err) end
        end)
    end

    local function formatSeconds(value)
        local seconds = math.max(0, math.floor(value + 0.5))
        return string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
    end

    local function refreshClock()
        local clock = lighting:GetAttribute("ClockTime")
        local now = os.clock()
        if type(clock) ~= "number" then return nil end
        clock %= 24
        if state.lastClock ~= nil and now - state.lastTime >= 0.5 then
            local delta = (clock - state.lastClock + 24) % 24
            local dt = now - state.lastTime
            if delta > 0 and delta < 0.2 then
                local rate = delta / dt
                if rate > 0 and rate < 0.1 then
                    state.clockRate = state.clockRate and state.clockRate * 0.6 + rate * 0.4 or rate
                    state.clockSamples += 1
                end
            elseif delta > 0.2 then
                state.clockRate, state.clockSamples = nil, 0
            end
            state.lastClock, state.lastTime = clock, now
        elseif state.lastClock == nil then
            state.lastClock, state.lastTime = clock, now
        end
        return clock
    end

    local function statusText()
        if game.PlaceId ~= 4747446334 then return "Join NYC zombies for evacuation information." end
        local clock = refreshClock()
        local clockText = clock and string.format("%02d:%02d", math.floor(clock), math.floor(clock % 1 * 60)) or "--:--"
        if state.position then
            return "Evac signal active · " .. clockText .. " game time\n" .. tostring(state.label)
                .. "\nFollow the waypoint to the helicopter. Departure time is unknown."
        end
        if state.server and state.server.ZOMBIES_PVP_RULES then
            if state.server.TIME_ENABLED == false then
                return "Nightly extraction · scheduled 20:00\nServer game clock is paused at " .. clockText
                    .. ".\nAwaiting a red-flare location; helicopter ETA unavailable."
            end
            local first = "Next nightly extraction · scheduled 20:00"
            if clock and state.clockRate and state.clockSamples >= 2 then
                local remaining = (20 - clock + 24) % 24
                first ..= "\n~" .. formatSeconds(remaining / state.clockRate) .. " estimated at the current clock speed"
            else
                first ..= "\nMeasuring server clock speed…"
            end
            return first .. "\nGame time " .. clockText .. " · awaiting red-flare location. Exact server ETA unavailable."
        end
        return "Rescue extraction · " .. clockText .. " game time\nEquip a CSEL and hold its use/fire control to request EXFIL.\nA pickup waypoint appears when the server publishes a marker or red flare."
    end

    local function makeWaypoint()
        if state.frame then return end
        local frame = Instance.new("Frame")
        frame.Name = "NYCEvacWaypoint"
        frame.BackgroundTransparency = 1
        frame.Size = UDim2.fromOffset(1, 1)
