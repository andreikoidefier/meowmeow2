-- Ronograd controller and muzzle adapters; activation remains separate from setup.
local farmTarget, farmWeapon, flightController, flightPosition, flightGoalY
local farmOverrides = {}
local protectedNPCs = setmetatable({}, {__mode = "k"})
local farmElapsed, weaponElapsed = 0, 0
local farmShots = 0
local farmFireWeapon
local farmReloadNext = 0
local farmScan = filtergc
local farmScope = runtimeScope
local farmVehicleService
local farmRay = RaycastParams.new()
farmRay.FilterType = Enum.RaycastFilterType.Exclude
farmRay.IgnoreWater = true

local function validFarmHelicopter(vehicle)
    if not config.FarmHeli or vehicle._vehicleName ~= "MI8AI" or vehicle.VehicleType ~= "Helicopter" or vehicle.Alive ~= true then return false end
    if not vehicle.Healths or (vehicle.Healths.Hull or 0) <= 0 or typeof(vehicle.Model) ~= "Instance" or not vehicle.Model.Parent then return false end
    for _, actor in pairs(replicator.Actors) do
        if actor.Owner ~= nil and actor.Seat and actor.Seat.UID == vehicle.UID then return false end
    end
    return true
end

local function farmTargetPoint(target)
    local vehicle = target._farmHelicopter
    if vehicle then
        local cf = vehicle.CFrame or (vehicle.Hitbox and vehicle.Hitbox.CFrame)
        return typeof(cf) == "CFrame" and cf.Position or nil
    end
    return triggerPoint(target, true)
end

local function validFarmNPC(actor)
    if actor._farmHelicopter then return validFarmHelicopter(actor._farmHelicopter) end
    if actor == replicator.LocalActor or actor.IsLocalPlayer or actor.Owner ~= nil then return false end
    if actor.Alive ~= true or type(actor.Health) ~= "number" or actor.Health <= 0 or actor.Firearm ~= true then return false end
    local character = actor.Character
    if typeof(character) ~= "Instance" then return false end
    local protected = protectedNPCs[character]
    if protected == nil then
        protected = character:HasTag("PreventPlayerFire")
        if not protected then
            for _, object in ipairs(character:GetDescendants()) do
                if object:HasTag("PreventPlayerFire") then protected = true; break end
            end
        end
        protectedNPCs[character] = protected
    end
    return not protected
end

local function farmVisible(actor, origin, point)
    local localActor = replicator.LocalActor
    local ignore = {workspace.CurrentCamera}
    if localActor and typeof(localActor.Character) == "Instance" then table.insert(ignore, localActor.Character) end
    farmRay.FilterDescendantsInstances = ignore
    local hit = workspace:Raycast(origin, point - origin, farmRay)
    return not hit or (typeof(actor.Character) == "Instance" and hit.Instance:IsDescendantOf(actor.Character))
end

local function stopFarmFire()
    local weapon = farmFireWeapon
    farmFireWeapon = nil
    if weapon and type(weapon._discharge) == "function" then pcall(weapon._discharge, weapon, false) end
end

local function stopFlight()
    if flightController then
        pcall(flightController.SetCFrame, flightController, nil, false, true)
        flightController.VelocityGravity = 0
    end
    flightController, flightPosition, flightGoalY = nil, nil, nil
end

local function attachFarmWeapon(weapon)
    if farmOverrides[weapon] or type(weapon.GetMuzzleCFrame) ~= "function" then return end
    local original = weapon.GetMuzzleCFrame
    farmOverrides[weapon] = original
    farmScope.override(weapon, "GetMuzzleCFrame", function(self, ...)
        local muzzle, a, b = original(self, ...)
        local target = farmTarget
        if stopped or not config.FarmAim or not target or not validFarmNPC(target) or typeof(muzzle) ~= "CFrame" then
            return muzzle, a, b
        end
        local point = farmTargetPoint(target)
        if not point or not farmVisible(target, muzzle.Position, point) then return muzzle, a, b end
        local distance = (point - muzzle.Position).Magnitude
        if distance > config.FarmRange then return muzzle, a, b end
        marker:SetAttribute("FarmRedirects", (marker:GetAttribute("FarmRedirects") or 0) + 1)
        return CFrame.lookAt(muzzle.Position, point), a, b
    end)
end

farmCleanup = function()
    stopFarmFire()
    stopFlight()
    for weapon, original in pairs(farmOverrides) do
        farmScope.override(weapon, "GetMuzzleCFrame", original)
    end
    runtimeRestore()
end

local function updateFarm(dt)
    if not (config.FarmAim or config.FarmAutoFire or config.FarmFly) then
        if farmWeapon or farmTarget or farmFireWeapon or flightController or next(farmOverrides) then
            farmTarget = nil
            stopFarmFire(); stopFlight()
            for weapon, original in pairs(farmOverrides) do
                farmScope.override(weapon, "GetMuzzleCFrame", original)
            end
            table.clear(farmOverrides)
            farmWeapon = nil
        end
        weaponElapsed = 0
        return
    end
    local localActor = replicator.LocalActor
    if stopped or game.PlaceId ~= 3701546109 or isPVP() or type(localActor) ~= "table" or not localActor.Alive then
        farmTarget = nil; stopFarmFire(); stopFlight()
        marker:SetAttribute("FarmStatus", "Ronograd only; spawn with a firearm")
        return
    end
    weaponElapsed += dt
    if weaponElapsed >= 1 and (config.FarmAim or config.FarmAutoFire) then
        weaponElapsed = 0
        if config.FarmAim and config.FarmHeli and not farmVehicleService then
            for _, service in ipairs(farmScan("table", {Keys = {"Vehicles"}}, false)) do
                if type(service.Vehicles) == "table" and type(service.GetFromBodyPart) == "function" then farmVehicleService = service; break end
            end
        end
        if farmWeapon and (farmWeapon._actor ~= localActor or not farmWeapon.Equipped) then farmWeapon = nil end
        for _, weapon in ipairs(farmScan("table", {Keys = {"_firearm", "_actor"}}, false)) do
            if weapon._actor == localActor and type(weapon._discharge) == "function" then
                if config.FarmAim then attachFarmWeapon(weapon) end
                if weapon.Equipped then farmWeapon = weapon end
            end
        end
    end
    if config.FarmFly and localActor.Controller and not localActor.Seat and not localActor.Downed then
        local controller = localActor.Controller
        if controller ~= flightController then
            local pendingGoal = flightGoalY
            stopFlight()
            flightGoalY = pendingGoal
            if not localActor.Forced then
                flightController = controller
                flightPosition = localActor.Position
                controller:SetCFrame(CFrame.new(flightPosition) * CFrame.Angles(0, localActor.CameraX or 0, 0), false, true)
            end
        end
        if flightController then
            local movement = Vector3.zero
            if isrbxactive() and not Input:GetFocusedTextBox() and not (gameInput and (gameInput.PauseOpen or gameInput.InventoryOpen)) then
                local camera = workspace.CurrentCamera
                if camera then
                    local forward = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
                    if forward.Magnitude > 0 then forward = forward.Unit end
                    local right = Vector3.new(camera.CFrame.RightVector.X, 0, camera.CFrame.RightVector.Z)
                    if Input:IsKeyDown(Enum.KeyCode.W) then movement += forward end
                    if Input:IsKeyDown(Enum.KeyCode.S) then movement -= forward end
                    if Input:IsKeyDown(Enum.KeyCode.D) then movement += right end
                    if Input:IsKeyDown(Enum.KeyCode.A) then movement -= right end
                    if Input:IsKeyDown(Enum.KeyCode.Space) or Input:IsKeyDown(Enum.KeyCode.E) then movement += Vector3.yAxis end
                    if Input:IsKeyDown(Enum.KeyCode.LeftControl) or Input:IsKeyDown(Enum.KeyCode.Q) then movement -= Vector3.yAxis end
                end
            end
            if movement.Magnitude > 0 then
                movement = movement.Unit * config.FarmFlySpeed * math.min(dt, 0.05)
                flightPosition += movement
                flightGoalY = nil
            elseif flightGoalY then
                local step = math.clamp(flightGoalY - flightPosition.Y, -config.FarmFlySpeed * math.min(dt, 0.05), config.FarmFlySpeed * math.min(dt, 0.05))
                flightPosition += Vector3.new(0, step, 0)
                if math.abs(flightPosition.Y - flightGoalY) < 0.1 then flightGoalY = nil end
            end
            controller._forceCFrame = CFrame.new(flightPosition) * CFrame.Angles(0, localActor.CameraX or 0, 0)
            controller.VelocityGravity = 0
        end
    else stopFlight() end
    farmElapsed += dt
    if farmElapsed < 0.2 then return end
    farmElapsed = 0
    local best, bestDistance = nil, config.FarmRange
    local camera = workspace.CurrentCamera
    if config.FarmAim and camera then
        if config.FarmHeli and farmVehicleService then
            for _, vehicle in pairs(farmVehicleService.Vehicles) do
                if validFarmHelicopter(vehicle) then
                    local candidate = {_farmHelicopter = vehicle, UID = vehicle.UID, Character = vehicle.Model, Health = vehicle.Healths.Hull}
                    local point = farmTargetPoint(candidate)
                    if point then
                        local distance = (point - localActor.Position).Magnitude
                        if distance < bestDistance and farmVisible(candidate, camera.CFrame.Position, point) then best, bestDistance = candidate, distance end
                    end
                end
            end
        end
        if not best then
        for _, actor in pairs(replicator.Actors) do
            if validFarmNPC(actor) then
                local point = triggerPoint(actor, true)
                if point then
                    local distance = (point - localActor.Position).Magnitude
