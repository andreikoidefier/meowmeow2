local function targetAllowed(actor)
    if actor.IsLocalPlayer or actor == replicator.LocalActor or actor.Owner == player then return false end
    if actor.Alive == false or (type(actor.Health) == "number" and actor.Health <= 0) then return false end
    local owner = actor.Owner
    if typeof(owner) == "Instance" and owner:IsA("Player") then
        if not config.Players then return false end
        local mine = clients.LocalClient
        local other = clients.Clients[owner]
        if isPVP() then
            -- Spectators/unassigned players stay hidden; do not infer teams from color.
            local a, b = mine and mine.Squad, other and other.Squad
            return (a == "Red" or a == "Blue") and (b == "Red" or b == "Blue") and a ~= b
        end
        if config.AllPlayers then return true end
        return mine and other and mine.Squad ~= nil and other.Squad ~= nil and mine.Squad ~= other.Squad
    end
    return config.NPCs
end

local function opposingSquads(a, b, pvp)
