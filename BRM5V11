        text.Name = "EvacDestination"
        text.AnchorPoint = Vector2.new(0.5, 0)
        text.Position = UDim2.fromOffset(0, 15)
        text.Size = UDim2.fromOffset(300, 44)
        text.BackgroundTransparency = 1
        text.Font = Enum.Font.GothamBold
        text.TextSize = 14
        text.TextStrokeColor3 = Color3.new(0, 0, 0)
        text.TextStrokeTransparency = 0.1
        text.ZIndex = 62
        text.Parent = frame
        local arrow = Instance.new("TextLabel")
        arrow.Name = "EvacDirection"
        arrow.AnchorPoint = Vector2.new(0.5, 0.5)
        arrow.Position = UDim2.fromOffset(0, -22)
        arrow.Size = UDim2.fromOffset(32, 32)
        arrow.BackgroundTransparency = 1
        arrow.Font = Enum.Font.GothamBold
        arrow.Text = "▲"
        arrow.TextSize = 22
        arrow.TextStrokeTransparency = 0.2
        arrow.ZIndex = 62
        arrow.Parent = frame
        state.frame, state.diamond, state.line, state.arrow, state.text = frame, diamond, line, arrow, text
        state.stroke = stroke
    end

    local function update(camera, dt)
        if state.closed then return end
        state.elapsed += dt
        if state.elapsed >= 0.5 then
            state.elapsed = 0
            local clock = lighting:GetAttribute("ClockTime")
            local clockText = type(clock) == "number" and string.format("%02d:%02d", math.floor(clock % 24), math.floor(clock % 1 * 60)) or "--:--"
            if state.setClockText then state.setClockText(clockText) end
            marker:SetAttribute("NYCGameClock", clockText)
            local text = statusText()
            if state.setText then state.setText(text) end
            marker:SetAttribute("NYCEvacStatus", text)
            marker:SetAttribute("NYCEvacLocationKnown", state.position ~= nil)
        end
        if game.PlaceId ~= 4747446334 or not nyc.EvacWaypoint or not state.position or not camera then
            if state.frame then state.frame.Visible = false end
            return
        end
        makeWaypoint()
        local viewport = camera.ViewportSize
        local projected, onScreen = camera:WorldToViewportPoint(state.position + Vector3.new(0, 3, 0))
        local center = viewport * 0.5
        local point = Vector2.new(projected.X, projected.Y)
        local direction = point - center
        if projected.Z <= 0 then direction = -direction end
        if direction.Magnitude < 0.01 then direction = Vector2.new(0, -1) end
        local marginX, marginY = math.min(160, viewport.X * 0.22), math.min(90, viewport.Y * 0.22)
        local edge = not onScreen or projected.Z <= 0 or point.X < marginX or point.X > viewport.X - marginX
            or point.Y < marginY or point.Y > viewport.Y - marginY
        if edge then
            local scale = math.min((center.X - marginX) / math.max(math.abs(direction.X), 0.001),
                (center.Y - marginY) / math.max(math.abs(direction.Y), 0.001))
            point = center + direction * scale
        end
        local color = nyc.EvacColor or Color3.fromRGB(100, 210, 255)
        state.frame.Position = UDim2.fromOffset(point.X, point.Y)
        state.frame.Visible = true
        state.diamond.BackgroundColor3 = color
        state.stroke.Color = color
        state.line.BackgroundColor3 = color
        state.line.Visible = not edge
        state.arrow.Visible = edge
        state.arrow.TextColor3 = color
        state.arrow.Rotation = math.deg(math.atan2(direction.Y, direction.X)) + 90
