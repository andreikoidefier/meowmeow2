local function updateActor(actor, entry, camera)
    local cf = actor.CFrame
    if typeof(cf) ~= "CFrame" then return false end
    local distance = (cf.Position - camera.CFrame.Position).Magnitude
    if distance > config.Distance then return false end
    local center, onScreen = camera:WorldToViewportPoint(cf.Position)
    if not onScreen or center.Z <= 0 then return false end
    local height = actor.HeightState == 2 and 2 or (actor.HeightState == 1 and 4 or 6)
    local half = Vector3.new(1.6, height / 2, 1)
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    for x = -1, 1, 2 do
        for y = -1, 1, 2 do
            for z = -1, 1, 2 do
                local v = camera:WorldToViewportPoint(cf:PointToWorldSpace(
                    Vector3.new(half.X * x, half.Y * y, half.Z * z)
                ))
                if v.Z <= 0 then return false end
                minX, minY = math.min(minX, v.X), math.min(minY, v.Y)
                maxX, maxY = math.max(maxX, v.X), math.max(maxY, v.Y)
            end
        end
    end
    local transparency = 1 - config.Alpha
    local stroke = entry.box:FindFirstChildOfClass("UIStroke")
    stroke.Color = config.Color
    stroke.Transparency = transparency
    stroke.Thickness = config.Thickness
    entry.box.Position = UDim2.fromOffset(minX, minY)
    entry.box.Size = UDim2.fromOffset(maxX - minX, maxY - minY)
    entry.box.Visible = config.Boxes
    local from = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y - 2)
    local to = Vector2.new(center.X, maxY)
    local delta = to - from
    entry.tracer.BackgroundColor3 = config.Color
    entry.tracer.BackgroundTransparency = transparency
    entry.tracer.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
    entry.tracer.Size = UDim2.fromOffset(delta.Magnitude, config.Thickness)
    entry.tracer.Rotation = math.deg(math.atan2(delta.Y, delta.X))
    entry.tracer.Visible = config.Tracers
    entry.label.TextColor3 = config.Color
    entry.label.TextTransparency = transparency
    entry.label.TextStrokeTransparency = transparency
    local owner = actor.Owner
    local name = typeof(owner) == "Instance" and owner:IsA("Player") and owner.DisplayName or "NPC"
    entry.label.Text = string.format("%s | %d studs", name, math.floor(distance))
    entry.label.Position = UDim2.fromOffset((minX + maxX) / 2, minY - 2)
    entry.label.Visible = config.Names
    return true
end

